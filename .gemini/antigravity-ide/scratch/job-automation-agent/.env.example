# App Secret Key for JWT & Encryption
SECRET_KEY=change-this-to-a-super-secret-key-32chars
FERNET_KEY=gAAAAABl... (generate using cryptography.fernet.Fernet.generate_key().decode())

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite for dev, PostgreSQL ready)
DATABASE_URL=sqlite:///./job_agent.db

# LLM Configuration (provider-agnostic: mock, gemini, anthropic, openai)
LLM_PROVIDER=mock
LLM_API_KEY=

# SMTP / IMAP Configuration (Optional / Mockable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=user@example.com
IMAP_PASSWORD=

# CORS
FRONTEND_URL=http://localhost:5173
